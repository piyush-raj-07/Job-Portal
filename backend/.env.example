# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# ---------- Server ----------
PORT=3000
# Set to "production" only on your deployed server
NODE_ENV=development
# Your React app's URL (used for CORS and for the link inside verification emails)
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
MONGO_URL=your_mongodb_connection_string

# ---------- JWT ----------
SECRET_KEY=your_jwt_secret
ACCESS_TOKEN_SECRET=a_long_random_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=a_different_long_random_string
REFRESH_TOKEN_EXPIRY=7d

# ---------- Cloudinary ----------
CLOUD_NAME=your_cloudinary_name
API_KEY=your_cloudinary_key
API_SECRET=your_cloudinary_secret

# ---------- AI ----------
GROQ_API_KEY=your_groq_key

# ---------- Email (Nodemailer / SMTP) ----------
# Leave these empty while developing and the verification link is printed
# in the backend terminal instead of being emailed.
#
# Gmail example: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="Job Portal <your_email@gmail.com>"
